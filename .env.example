# PortWatch Configuration

# Server & Network
PORT=3100
HOST=0.0.0.0
NODE_ENV=development

# Database (PostgreSQL 16)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/portwatch?schema=public

# Authentication
# REQUIRED in production - no default is shipped. Generate a strong secret:
#   openssl rand -hex 32
# Leave empty for local development (a random per-process secret is used,
# sessions are invalidated whenever the API restarts).
JWT_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_EMAIL=admin@leadowserver.local

# Scanner Configuration
# Mode: "host" (executes ss -tlnpH on host) | "mock" (for isolated containers) | "agent" (calls remote agent)
SCANNER_MODE=host
SCAN_INTERVAL_SEC=30
TCP_TIMEOUT_MS=3000
SLOW_THRESHOLD_MS=1500
CONCURRENCY_LIMIT=20
RETENTION_DAYS=90

# Frontend Configuration
VITE_API_URL=http://localhost:3100
